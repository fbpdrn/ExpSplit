# Le variabili servono a configurare la creazione dei ruoli nel database e nei container per la connessione
POSTGRES_PASSWORD=expsplit
AUTH_DB_PASSWORD=expsplit_auth
EXPSPLIT_DB_PASSWORD=expsplit_app

# Password dei keystore/truststore PKCS12 per il mTLS interno (generati da certs/generate.sh).
CERT_PASSWORD=expsplit_cert